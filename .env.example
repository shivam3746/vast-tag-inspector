HOST=127.0.0.1
PORT=3000
# Use the development project's Postgres connection string with TLS enabled.
DATABASE_URL=
# Project URL from Supabase, using the same project as DATABASE_URL.
SUPABASE_URL=
# Publishable key for browser sign-in.
SUPABASE_PUBLISHABLE_KEY=
# Use rules, ollama for a local model, or gemini for a Free Tier project.
EXPLANATION_PROVIDER=rules
# Server-only key from a Gemini Free Tier project without billing.
GEMINI_API_KEY=
