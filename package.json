{
  "name": "vast-tag-inspector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch apps/api/src/server.ts",
    "dev:web": "npm run dev -w @vast-tag/web",
    "build": "tsc -p apps/api/tsconfig.build.json && npm run build -w @vast-tag/web",
    "start": "node apps/api/dist/server.js",
    "db:check": "node --env-file-if-exists=.env apps/api/src/db-check.ts",
    "db:migrate": "node --env-file-if-exists=.env apps/api/src/db-migrate.ts",
    "inspect": "node apps/cli/src/inspect.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && npm run typecheck -w @vast-tag/web",
    "test": "vitest run",
    "eval": "node --env-file-if-exists=.env eval/run.ts",
    "test:e2e": "playwright test --config apps/web/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.18.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^10.15.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
